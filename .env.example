# Backend configuration for NASC SPORTS

# Initial staff portal password - used ONLY to seed the database hash on first
# boot. After the staff change their password from the dashboard, the new
# (scrypt-hashed) password is stored in the database and this value is ignored.
STAFF_PASSWORD=NASCPD

# Long random secret for session signing. Change before deploying.
SESSION_SECRET=replace-this-with-a-long-random-secret

# Server port (Render sets this automatically).
PORT=3000

# Set to true when the server is served behind HTTPS (Render: NODE_ENV=production
# also enables this). Enables SameSite=None + Secure session cookies so the
# Android app (origin https://localhost) can maintain a staff session.
COOKIE_SECURE=true